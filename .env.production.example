# Copy to .env.production. Do not commit the populated file.
SECONDHAND_MYSQL_ROOT_PASSWORD=replace-with-a-long-unique-root-password
SECONDHAND_MYSQL_DATABASE=secondhand
SECONDHAND_MYSQL_USER=secondhand_app
SECONDHAND_MYSQL_PASSWORD=replace-with-a-long-unique-app-password
SECONDHAND_REDIS_PASSWORD=replace-with-a-long-unique-redis-password
SECONDHAND_MONGO_ROOT_USER=secondhand_root
SECONDHAND_MONGO_ROOT_PASSWORD=replace-with-a-long-unique-mongo-password
SECONDHAND_MONGO_DATABASE=secondhand
SECONDHAND_RABBITMQ_USER=secondhand_app
SECONDHAND_RABBITMQ_PASSWORD=replace-with-a-long-unique-rabbitmq-password
SECONDHAND_RABBITMQ_VHOST=secondhand
SECONDHAND_JWT_ADMIN_SECRET=replace-with-a-long-random-admin-jwt-secret
SECONDHAND_JWT_USER_SECRET=replace-with-a-long-random-user-jwt-secret
SECONDHAND_UPLOAD_SIGN_SECRET=replace-with-a-long-random-upload-signing-secret
SECONDHAND_PAYMENT_MOCK_SIGN=replace-with-a-long-random-demo-payment-signature
SECONDHAND_PAYMENT_MODE=mock
SECONDHAND_PAYMENT_ENDPOINT_ENABLED=false
SECONDHAND_PUBLIC_URL=http://localhost
SECONDHAND_MAIL_HOST=mail.example.invalid
SECONDHAND_MAIL_PORT=587
SECONDHAND_MAIL_USERNAME=replace-with-smtp-username
SECONDHAND_MAIL_PASSWORD=replace-with-smtp-password
SECONDHAND_DEPLOYMENT_MODE=production
SECONDHAND_DEMO_SEED_ENABLED=false
